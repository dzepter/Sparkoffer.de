# Handel Offensiv – Beispiel-Umgebungsvariablen
# Kopieren nach .env (lokal) bzw. in der jeweiligen Deploy-Umgebung setzen.
# NIEMALS echte Werte committen. NIEMALS den Service-Role-Key in App- oder Browser-Code verwenden.

# --- Supabase (Projekt je Environment: staging / production getrennt) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Nur serverseitig (Edge Functions, Admin-Server-Actions). Nie im Client:
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin-Cockpit (Next.js) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
ADMIN_BASE_URL=

# --- Mobile App (Expo) ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- E-Mail-Versand (Einladungen, Passwort-Reset über eigenen SMTP/Provider) ---
EMAIL_FROM=
EMAIL_PROVIDER_API_KEY=

# --- Push (Expo) ---
EXPO_ACCESS_TOKEN=
