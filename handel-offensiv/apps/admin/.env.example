# Supabase (lokal: Werte aus `supabase start`; Staging/Produktion: Projekt in eu-central-1/Frankfurt)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NUR serverseitig – niemals mit NEXT_PUBLIC_-Praefix versehen!
# Der Service-Role-Key umgeht RLS vollstaendig (siehe src/lib/supabase/admin.ts).
# Er wird NUR fuer Datenbankzugriffe in Server Actions genutzt – Edge Functions
# werden mit dem JWT der angemeldeten Person aufgerufen (src/lib/edge-functions.ts).
SUPABASE_SERVICE_ROLE_KEY=

# Oeffentliche Basis-URL dieses Cockpits (Redirect-Ziel fuer Passwort-Reset-Mails).
# Muss in supabase/config.toml unter additional_redirect_urls stehen.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Playwright-E2E (optional, Default http://localhost:3000)
E2E_BASE_URL=http://localhost:3000
