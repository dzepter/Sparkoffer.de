# Supabase (lokal: Werte aus `supabase start`; Staging/Produktion: Projekt in eu-central-1/Frankfurt)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NUR serverseitig – niemals mit NEXT_PUBLIC_-Praefix versehen!
# Der Service-Role-Key umgeht RLS vollstaendig (siehe src/lib/supabase/admin.ts).
# Er wird NUR fuer Datenbankzugriffe in Server Actions genutzt – Edge Functions
# werden mit dem JWT der angemeldeten Person aufgerufen (src/lib/edge-functions.ts).
# PFLICHT in Staging/Produktion: ohne Key startet der Server nicht (src/instrumentation.ts).
SUPABASE_SERVICE_ROLE_KEY=

# Salt fuer die Hashes der Rate-Limit-Schluessel (IP/E-Mail werden nie im Klartext gespeichert).
# PFLICHT in Staging/Produktion (zufaellig, >= 32 Zeichen); lokal optional (Entwicklungs-Fallback).
RATE_LIMIT_SALT=

# Oeffentliche Basis-URL des Cockpits INKLUSIVE Pfad-Praefix /admin
# (Redirect-Ziel fuer Passwort-Reset-Mails: <Basis>/auth/callback).
# Produktion: https://www.handel-offensiv.de/admin · Staging: <Shell-Vorschau>/admin
# Muss in supabase/config.toml unter additional_redirect_urls stehen.
NEXT_PUBLIC_APP_URL=http://localhost:3000/admin

# Hosts, von denen Formulare (Server Actions) angenommen werden – der Host der
# Website-Shell, ueber die das Cockpit ausgeliefert wird (kommagetrennt).
# Produktion: www.handel-offensiv.de,handel-offensiv.de · lokal: Shell auf Port 3100
SERVER_ACTIONS_ALLOWED_ORIGINS=localhost:3100

# Playwright-E2E: Host OHNE Praefix (die Tests haengen /admin selbst an)
E2E_BASE_URL=http://localhost:3000
