# Supabase (lokal: Werte aus `supabase start`; Staging/Produktion: Projekt in eu-central-1/Frankfurt)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NUR serverseitig (Rate Limit, Anfrage-/Einladungs-Helfer). Niemals mit NEXT_PUBLIC_.
# Der Campus liest und schreibt Lerndaten AUSSCHLIESSLICH ueber die Nutzersitzung (RLS).
# PFLICHT in Staging/Produktion: ohne Key startet der Server nicht (src/instrumentation.ts);
# das Rate Limit (Login, Passwort-Reset, Einladung) faellt sonst geschlossen aus.
SUPABASE_SERVICE_ROLE_KEY=

# Salt fuer die Hashes der Rate-Limit-Schluessel (IP/E-Mail werden nie im Klartext gespeichert).
# PFLICHT in Staging/Produktion (zufaellig, >= 32 Zeichen); lokal optional (Entwicklungs-Fallback).
RATE_LIMIT_SALT=

# Gemeinsames Secret mit den Edge Functions (Function Secret CAMPUS_CLIENT_IP_SECRET):
# Der Campus reicht die Besucher-IP signiert an accept-invitation weiter, damit das
# Rate Limit je Besucher gilt und nicht je Campus-Server. Ohne Secret: kein Weiterreichen.
CAMPUS_CLIENT_IP_SECRET=

# Oeffentliche Basis-URL des Campus (Redirect-Ziel fuer Passwort-Reset-Mails).
# Muss in supabase/config.toml unter additional_redirect_urls stehen.
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Playwright-E2E (optional, Default http://localhost:3001)
E2E_BASE_URL=http://localhost:3001
